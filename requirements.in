# Top-level dependencies of p4gui, puckutility and pucktuner (and their p4core /
# p4sysid submodules). requirements.txt is compiled from this file; keep both
# byte-identical in all three repos. After editing:
#   uv pip compile requirements.in --universal --python-version 3.12 \
#     --no-header --no-annotate \
#     --find-links https://extras.wxpython.org/wxPython4/extras/linux/gtk3/ubuntu-20.04/
# then put the header comment back on requirements.txt.
